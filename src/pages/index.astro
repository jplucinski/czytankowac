---
import FuelCard from '../components/FuelCard.astro';
import ReviewNote from '../components/ReviewNote.astro';
import { ForecastSchema } from '../domain/forecast';
import { PublishedReviewSchema } from '../domain/review';
import Base from '../layouts/Base.astro';
import latestRaw from '../data/latest.json';

const reviewModules = import.meta.glob<{ default: unknown }>('../data/review.json', {
  eager: true,
});
const reviewRaw = Object.values(reviewModules)[0]?.default;
const review = reviewRaw ? PublishedReviewSchema.safeParse(reviewRaw) : null;

const forecast = ForecastSchema.parse(latestRaw);
const updatedAt = new Date(forecast.asOf).toLocaleString('pl-PL', {
  dateStyle: 'long',
  timeStyle: 'short',
  timeZone: 'Europe/Warsaw',
});
---

<Base title="Czy tankować?">
  <h1 class="page-title">Czy tankować?</h1>
  <p class="page-meta">
    Prognoza na {forecast.horizonDays} dni · aktualizacja {updatedAt}
  </p>

  <section class="fuel-list" aria-label="Rekomendacje paliw">
    {forecast.fuels.map((fuel) => <FuelCard fuel={fuel} />)}
  </section>

  {review?.success ? <ReviewNote review={review.data} /> : null}

  <p class="model-caveat">
    Rekomendacja modelu jest słaba. To orientacyjny sygnał, nie pewna prognoza cen.
  </p>

  <details class="sources">
    <summary>Źródła</summary>
    <ul>
      {
        forecast.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</Base>
